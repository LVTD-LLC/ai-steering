---
import BaseLayout from '../layouts/BaseLayout.astro';
import { createAwesomeRepoSearchUrl, installableSkill, sections, siteLinks } from '../data/resources';
import { slugify } from '../lib/slugify.js';

const totalResources = sections.reduce((total, section) => total + section.resources.length, 0);
const catalogItems = sections.flatMap((section) => section.resources);
const catalogSchema = {
  '@type': 'ItemList',
  '@id': `${siteLinks.site}/#catalog`,
  name: 'AI steering file catalog',
  description: 'A curated catalog of steering files and agent instruction files for AI coding agents.',
  itemListElement: catalogItems.map((resource, index) => ({
    '@type': 'ListItem',
    position: index + 1,
    item: {
      '@type': 'CreativeWork',
      name: resource.name,
      url: `${siteLinks.site}/#${slugify(resource.name)}`,
      description: resource.summary
    }
  }))
};
---

<BaseLayout
  title="AI Steering Files - choose repo context for coding agents"
  description="Explore practical AGENTS.md, PRODUCT.md, TECH.md, and tool-specific instruction file patterns for AI coding agents."
  structuredData={[catalogSchema]}
  hideFooter={true}
>
  <main id="main-content" class="explorer-shell scheme-only-dark">
    <header class="app-header">
      <a class="brand" href="/" aria-label="Homepage">
        <img src="/logo.svg" alt="" width="28" height="28" />
        <span>ai-steering</span>
      </a>

      <div class="location" aria-label="Current location">
        <span>repository</span>
        <span aria-hidden="true">/</span>
        <strong>context library</strong>
      </div>

      <nav class="desktop-links" aria-label="Project links">
        <a href={siteLinks.repo}>GitHub</a>
        <a href="/llms.txt">Text version</a>
      </nav>

      <details class="mobile-menu">
        <summary>Menu</summary>
        <div class="mobile-menu-panel">
          <nav aria-label="Mobile catalog navigation">
            <a href="#catalog">Catalog overview</a>
            <a href="#install-skill">Install the skill</a>
            <a href={siteLinks.repo}>GitHub repository</a>
            <a href="/llms.txt">Text version</a>
            {sections.map((section) => (
              <div>
                <p>{section.title}</p>
                <ul role="list">
                  {section.resources.map((resource) => (
                    <li><a href={`#${slugify(resource.name)}`}>{resource.path}</a></li>
                  ))}
                </ul>
              </div>
            ))}
          </nav>
        </div>
      </details>
    </header>

    <div class="workspace">
      <aside class="sidebar" aria-labelledby="catalog-tree-title">
        <div class="sidebar-heading">
          <h2 id="catalog-tree-title">Catalog</h2>
          <span>{totalResources} files</span>
        </div>

        <nav aria-label="Steering file catalog">
          {sections.map((section) => (
            <section class="tree-group" aria-labelledby={`tree-${section.slug}`}>
              <h3 id={`tree-${section.slug}`}>{section.title}</h3>
              <ul role="list">
                {section.resources.map((resource) => (
                  <li><a href={`#${slugify(resource.name)}`}>{resource.path}</a></li>
                ))}
              </ul>
            </section>
          ))}
        </nav>

        <section class="sidebar-skill" aria-labelledby="sidebar-skill-title">
          <p>Reusable skill</p>
          <h3 id="sidebar-skill-title">{installableSkill.name}</h3>
          <a href="#install-skill">Installation commands</a>
        </section>
      </aside>

      <div class="content-pane">
        <section class="intro" aria-labelledby="page-title">
          <p class="eyebrow">Repository context reference</p>
          <h1 id="page-title">Find the file that stops your coding agent from guessing</h1>
          <p class="intro-copy">
            Search by problem, file name, or use case. Open a result to see what belongs inside it, which references are reliable, and examples worth studying.
          </p>

          <div class="search-field">
            <label for="catalog-search">Filter the catalog</label>
            <div class="search-control">
              <input
                id="catalog-search"
                name="catalog-search"
                type="search"
                placeholder="Try “commands”, “design”, or “Claude”…"
                autocomplete="off"
                data-catalog-search
              />
              <kbd aria-hidden="true">/</kbd>
            </div>
            <p class="search-status" aria-live="polite" data-search-status>
              Showing all {totalResources} file patterns.
            </p>
          </div>
        </section>

        <section id="catalog" class="catalog" aria-labelledby="catalog-title">
          <header class="catalog-heading">
            <div>
              <p class="eyebrow">Indexed source files</p>
              <h2 id="catalog-title">Context library</h2>
            </div>
            <p>Shared files establish repository truth. Tool-specific files adapt that truth only where an assistant needs different syntax or behavior.</p>
          </header>

          <div class="catalog-results" data-catalog-results>
            {sections.map((section) => (
              <section class="catalog-section" aria-labelledby={`${section.slug}-title`} data-catalog-section>
                <header>
                  <div>
                    <h3 id={`${section.slug}-title`}>{section.title}</h3>
                    <span>{section.resources.length} files</span>
                  </div>
                  <p>{section.intro}</p>
                </header>

                <div class="file-list">
                  {section.resources.map((resource) => {
                    const awesomeRepoSearchHref = section.showAwesomeRepoSearch
                      ? createAwesomeRepoSearchUrl(resource.path)
                      : null;

                    return (
                      <details
                        class="file-record"
                        id={slugify(resource.name)}
                        data-searchable={`${resource.name} ${resource.path} ${resource.summary} ${resource.useItFor.join(' ')} ${resource.shouldContain.join(' ')}`.toLowerCase()}
                      >
                        <summary>
                          <div class="file-identity">
                            <code>{resource.path}</code>
                            <p>{resource.summary}</p>
                          </div>
                          <span class="file-kind">{section === sections[0] ? 'Shared' : 'Tool-specific'}</span>
                          <span class="file-action" aria-hidden="true"></span>
                        </summary>

                        <div class="file-panel-container">
                          <div class="file-panel">
                            <section aria-labelledby={`${slugify(resource.name)}-uses`}>
                              <h4 id={`${slugify(resource.name)}-uses`}>Use it for</h4>
                              <ul role="list">
                                {resource.useItFor.map((item) => <li>{item}</li>)}
                              </ul>
                            </section>

                            <section aria-labelledby={`${slugify(resource.name)}-contents`}>
                              <h4 id={`${slugify(resource.name)}-contents`}>Should contain</h4>
                              <ul role="list">
                                {resource.shouldContain.map((item) => <li>{item}</li>)}
                              </ul>
                            </section>

                            <section class="reference-column" aria-labelledby={`${slugify(resource.name)}-references`}>
                              <h4 id={`${slugify(resource.name)}-references`}>References</h4>
                              <ul role="list">
                                {resource.usefulResources.map((link) => (
                                  <li><a href={link.href}>{link.label}</a></li>
                                ))}
                              </ul>

                              <h4>Examples</h4>
                              <ul role="list">
                                {resource.greatExamples.map((link) => (
                                  <li><a href={link.href}>{link.label}</a></li>
                                ))}
                                {awesomeRepoSearchHref && (
                                  <li><a href={awesomeRepoSearchHref}>More examples on Awesome</a></li>
                                )}
                              </ul>
                            </section>
                          </div>
                        </div>
                      </details>
                    );
                  })}
                </div>
              </section>
            ))}
          </div>

          <div class="empty-state" data-empty-state hidden>
            <h3>No matching files</h3>
            <p>Try a broader term such as “commands”, “product”, “structure”, or an assistant name.</p>
          </div>
        </section>

        <section id="install-skill" class="install-section" aria-labelledby="install-title">
          <div class="install-copy">
            <p class="eyebrow">Reusable workflow</p>
            <h2 id="install-title">Install the catalog as an agent skill</h2>
            <p>The skill helps an agent choose, write, and audit steering files without copying this catalog into every repository.</p>
            <a href={siteLinks.skill}>Read the skill source</a>
          </div>

          <div class="install-terminal" aria-label="Skill installation command">
            <div>
              <span>Skills CLI</span>
              <span>shell</span>
            </div>
            <code id="skill-install-command">{installableSkill.skillsCliCommand}</code>
            <button type="button" data-copy-target="skill-install-command">
              Copy command
              <span class="touch-target" aria-hidden="true"></span>
            </button>
          </div>
        </section>
      </div>
    </div>

    <footer class="status-footer">
      <p><span>{totalResources}</span> indexed file patterns</p>
      <p>Source: <a href={siteLinks.source}>src/data/steering-data.js</a></p>
      <nav aria-label="Footer links">
        <a href={siteLinks.repo}>Repository</a>
        <a href={siteLinks.readme}>README</a>
      </nav>
    </footer>
  </main>
</BaseLayout>

<script is:inline>
  const searchInput = document.querySelector('[data-catalog-search]');
  const searchableFiles = [...document.querySelectorAll('[data-searchable]')];
  const catalogSections = [...document.querySelectorAll('[data-catalog-section]')];
  const emptyState = document.querySelector('[data-empty-state]');
  const searchStatus = document.querySelector('[data-search-status]');

  const filterCatalog = () => {
    const query = searchInput?.value.trim().toLowerCase() ?? '';
    let matches = 0;

    searchableFiles.forEach((file) => {
      const isMatch = !query || file.dataset.searchable.includes(query);
      file.hidden = !isMatch;
      if (isMatch) matches += 1;
    });

    catalogSections.forEach((section) => {
      section.hidden = !section.querySelector('[data-searchable]:not([hidden])');
    });

    if (emptyState) emptyState.hidden = matches !== 0;
    if (searchStatus) {
      searchStatus.textContent = query
        ? `${matches} ${matches === 1 ? 'file pattern matches' : 'file patterns match'} “${searchInput.value.trim()}”.`
        : `Showing all ${searchableFiles.length} file patterns.`;
    }
  };

  searchInput?.addEventListener('input', filterCatalog);

  document.addEventListener('keydown', (event) => {
    const activeElement = document.activeElement;
    const isTyping = activeElement instanceof HTMLInputElement || activeElement instanceof HTMLTextAreaElement;
    if (event.key === '/' && !isTyping) {
      event.preventDefault();
      searchInput?.focus();
    }
  });

  document.querySelectorAll('[data-copy-target]').forEach((button) => {
    button.addEventListener('click', async () => {
      const targetId = button.getAttribute('data-copy-target');
      const target = targetId ? document.getElementById(targetId) : null;
      if (!target) return;

      const originalLabel = button.firstChild?.textContent?.trim() || 'Copy command';
      try {
        await navigator.clipboard.writeText(target.textContent.trim());
        button.firstChild.textContent = 'Copied';
      } catch {
        const selection = window.getSelection();
        const range = document.createRange();
        range.selectNodeContents(target);
        selection?.removeAllRanges();
        selection?.addRange(range);
        button.firstChild.textContent = 'Selected';
      }

      window.setTimeout(() => {
        button.firstChild.textContent = originalLabel;
      }, 1800);
    });
  });
</script>

<style>
  :global(body) {
    background: #0d110f;
    color: #eef3ef;
  }

  .explorer-shell {
    --canvas: #0d110f;
    --surface: #121815;
    --surface-raised: #171f1b;
    --surface-muted: #1b2420;
    --text: #eef3ef;
    --text-muted: #a6b2aa;
    --text-subtle: #77837c;
    --line: rgba(238, 243, 239, 0.11);
    --line-strong: rgba(238, 243, 239, 0.2);
    --accent: #6ee7a2;
    --accent-strong: #45c980;
    --focus: #87a9ff;
    min-height: 100vh;
    background: var(--canvas);
    color: var(--text);
    color-scheme: dark;
    font-family: ui-monospace, "SFMono-Regular", Consolas, "Liberation Mono", monospace;
    isolation: isolate;
  }

  .app-header {
    position: sticky;
    top: 0;
    z-index: 10;
    display: grid;
    grid-template-columns: 17rem minmax(0, 1fr) auto;
    align-items: center;
    min-height: 3.5rem;
    border-bottom: 1px solid var(--line);
    background: rgba(18, 24, 21, 0.96);
    backdrop-filter: blur(12px);
  }

  .brand {
    display: flex;
    min-width: 0;
    align-items: center;
    gap: 0.625rem;
    height: 100%;
    border-right: 1px solid var(--line);
    color: var(--text);
    font-family: ui-sans-serif, system-ui, sans-serif;
    font-size: 0.875rem;
    font-weight: 700;
    padding: 0 1rem;
    text-decoration: none;
  }

  .brand img {
    width: 1.5rem;
    height: 1.5rem;
    flex: 0 0 auto;
  }

  .location,
  .desktop-links {
    display: flex;
    align-items: center;
    gap: 0.625rem;
    padding: 0 1rem;
  }

  .location {
    min-width: 0;
    color: var(--text-subtle);
    font-size: 0.75rem;
  }

  .location strong {
    overflow: hidden;
    color: var(--text-muted);
    font-weight: 500;
    text-overflow: ellipsis;
    white-space: nowrap;
  }

  .desktop-links a {
    color: var(--text-muted);
    font-size: 0.75rem;
    font-weight: 500;
    text-decoration: none;
  }

  .desktop-links a:hover,
  .brand:hover,
  .tree-group a:hover,
  .mobile-menu-panel a:hover,
  .status-footer a:hover {
    color: var(--text);
  }

  .mobile-menu { display: none; }

  .workspace {
    display: grid;
    grid-template-columns: 17rem minmax(0, 1fr);
    align-items: start;
  }

  .sidebar {
    position: sticky;
    top: 3.5rem;
    height: calc(100vh - 3.5rem);
    overflow-y: auto;
    border-right: 1px solid var(--line);
    background: var(--surface);
    padding-bottom: 1.5rem;
  }

  .sidebar-heading {
    display: flex;
    align-items: center;
    justify-content: space-between;
    min-height: 3rem;
    border-bottom: 1px solid var(--line);
    padding: 0 1rem;
  }

  .sidebar-heading h2,
  .sidebar-heading span {
    margin: 0;
    font-size: 0.7rem;
    font-weight: 600;
    letter-spacing: 0.08em;
    text-transform: uppercase;
  }

  .sidebar-heading span { color: var(--text-subtle); font-variant-numeric: tabular-nums; }

  .tree-group { padding-top: 1.25rem; }

  .tree-group h3 {
    margin: 0 1rem 0.5rem;
    color: var(--text-subtle);
    font-size: 0.7rem;
    font-weight: 500;
    letter-spacing: 0.06em;
    text-transform: uppercase;
  }

  .tree-group ul,
  .mobile-menu-panel ul {
    margin: 0;
    padding: 0;
    list-style: none;
  }

  .tree-group a {
    display: block;
    overflow: hidden;
    color: var(--text-muted);
    font-size: 0.8125rem;
    font-weight: 500;
    padding: 0.45rem 1rem 0.45rem 1.5rem;
    text-decoration: none;
    text-overflow: ellipsis;
    white-space: nowrap;
  }

  .tree-group a:focus-visible,
  .mobile-menu-panel a:focus-visible {
    outline: 2px solid var(--focus);
    outline-offset: -2px;
  }

  .sidebar-skill {
    display: grid;
    gap: 0.45rem;
    margin: 1.5rem 1rem 0;
    border-top: 1px solid var(--line-strong);
    padding-top: 1rem;
  }

  .sidebar-skill p,
  .sidebar-skill h3 { margin: 0; }
  .sidebar-skill p { color: var(--text-subtle); font-size: 0.7rem; text-transform: uppercase; letter-spacing: 0.06em; }
  .sidebar-skill h3 { color: var(--accent); font-size: 0.8125rem; font-weight: 500; }
  .sidebar-skill a { color: var(--text-muted); font-size: 0.75rem; }

  .content-pane { min-width: 0; }

  .intro {
    border-bottom: 1px solid var(--line);
    padding: 3rem clamp(1.5rem, 5vw, 5rem) 2.75rem;
  }

  .eyebrow {
    margin: 0;
    color: var(--accent);
    font-size: 0.75rem;
    font-weight: 600;
    letter-spacing: 0.08em;
    text-transform: uppercase;
  }

  .intro h1 {
    max-width: 25ch;
    margin: 0.75rem 0 0;
    font-family: ui-sans-serif, system-ui, sans-serif;
    font-size: clamp(2.35rem, 4vw, 3.75rem);
    font-weight: 600;
    line-height: 1.03;
    letter-spacing: -0.045em;
    text-wrap: balance;
  }

  .intro-copy {
    max-width: 62ch;
    margin: 1.25rem 0 0;
    color: var(--text-muted);
    font-family: ui-sans-serif, system-ui, sans-serif;
    font-size: 1rem;
    line-height: 1.65;
    text-wrap: pretty;
  }

  .search-field {
    display: grid;
    gap: 0.5rem;
    max-width: 48rem;
    margin-top: 2rem;
  }

  .search-field label {
    color: var(--text-muted);
    font-size: 0.75rem;
    font-weight: 600;
  }

  .search-control {
    display: grid;
    grid-template-columns: minmax(0, 1fr) auto;
    align-items: center;
    border: 1px solid var(--line-strong);
    border-radius: 0.5rem;
    background: #090c0a;
  }

  .search-control:focus-within {
    outline: 2px solid var(--focus);
    outline-offset: -1px;
  }

  .search-control input {
    min-width: 0;
    min-height: 3rem;
    border: 0;
    outline: 0;
    background: transparent;
    color: var(--text);
    font: inherit;
    font-size: 1rem;
    padding: 0.75rem 0 0.75rem 0.875rem;
  }

  .search-control input::placeholder { color: var(--text-subtle); }

  .search-control kbd {
    margin-right: 0.75rem;
    border: 1px solid var(--line-strong);
    border-radius: 0.25rem;
    color: var(--text-subtle);
    font: inherit;
    font-size: 0.75rem;
    padding: 0.1rem 0.35rem;
  }

  .search-status {
    min-height: 1.25rem;
    margin: 0;
    color: var(--text-subtle);
    font-size: 0.75rem;
    font-variant-numeric: tabular-nums;
  }

  .catalog { padding: 3.5rem clamp(1.5rem, 5vw, 5rem) 5rem; }

  .catalog-heading {
    display: grid;
    grid-template-columns: minmax(14rem, 0.55fr) 1fr;
    gap: 2.5rem;
    align-items: end;
    padding-bottom: 2rem;
  }

  .catalog-heading h2 {
    margin: 0.4rem 0 0;
    font-family: ui-sans-serif, system-ui, sans-serif;
    font-size: 2rem;
    font-weight: 600;
    letter-spacing: -0.035em;
    text-wrap: balance;
  }

  .catalog-heading > p {
    max-width: 64ch;
    margin: 0;
    color: var(--text-muted);
    font-family: ui-sans-serif, system-ui, sans-serif;
    font-size: 0.9375rem;
    line-height: 1.6;
    text-wrap: pretty;
  }

  .catalog-section { padding-top: 3.5rem; scroll-margin-top: 4rem; }

  .catalog-section > header {
    display: grid;
    grid-template-columns: minmax(14rem, 0.55fr) 1fr;
    gap: 2.5rem;
    align-items: start;
    padding-bottom: 1rem;
  }

  .catalog-section > header > div {
    display: flex;
    align-items: baseline;
    justify-content: space-between;
    gap: 1rem;
  }

  .catalog-section h3 {
    margin: 0;
    font-family: ui-sans-serif, system-ui, sans-serif;
    font-size: 1.25rem;
    font-weight: 600;
  }

  .catalog-section header span {
    flex: 0 0 auto;
    color: var(--text-subtle);
    font-size: 0.7rem;
    font-variant-numeric: tabular-nums;
  }

  .catalog-section header p {
    max-width: 64ch;
    margin: 0;
    color: var(--text-muted);
    font-family: ui-sans-serif, system-ui, sans-serif;
    font-size: 0.9375rem;
    line-height: 1.55;
    text-wrap: pretty;
  }

  .file-list { border-top: 1px solid var(--line-strong); }

  .file-record {
    border-bottom: 1px solid var(--line);
    scroll-margin-top: 4.5rem;
  }

  .file-record summary {
    display: grid;
    grid-template-columns: minmax(0, 1fr) auto 3.5rem;
    gap: 1rem;
    align-items: center;
    min-height: 5rem;
    cursor: pointer;
    list-style: none;
  }

  .file-record summary::-webkit-details-marker { display: none; }
  .file-record summary:hover .file-identity code { color: var(--accent); }
  .file-record summary:focus-visible { outline: 2px solid var(--focus); outline-offset: -2px; }

  .file-identity {
    display: grid;
    grid-template-columns: minmax(9rem, 0.35fr) 1fr;
    gap: 1.25rem;
    align-items: baseline;
    min-width: 0;
  }

  .file-identity code {
    overflow: hidden;
    background: transparent;
    color: var(--text);
    font-size: 0.8125rem;
    padding: 0;
    text-overflow: ellipsis;
    white-space: nowrap;
  }

  .file-identity p {
    min-width: 0;
    margin: 0;
    color: var(--text-muted);
    font-family: ui-sans-serif, system-ui, sans-serif;
    font-size: 0.9375rem;
    line-height: 1.5;
    text-wrap: pretty;
  }

  .file-kind {
    border: 1px solid rgba(110, 231, 162, 0.22);
    border-radius: 999px;
    background: rgba(110, 231, 162, 0.07);
    color: #9befbd;
    font-size: 0.6875rem;
    padding: 0.25rem 0.5rem;
  }

  .file-action {
    color: var(--text-subtle);
    font-size: 0.6875rem;
    text-align: right;
  }

  .file-action::after { content: "Open"; }
  .file-record[open] .file-action::after { content: "Close"; }

  .file-panel-container { container-type: inline-size; }

  .file-panel {
    display: grid;
    grid-template-columns: 1fr 1fr 1fr;
    gap: 0;
    margin-bottom: 1rem;
    border-radius: 0.5rem;
    background: var(--surface-raised);
    padding: 1.5rem;
  }

  .file-panel > section {
    min-width: 0;
    padding-right: 1.5rem;
  }

  .file-panel > section + section {
    border-left: 1px solid var(--line);
    padding-left: 1.5rem;
  }

  .file-panel > section:last-child { padding-right: 0; }

  .file-panel h4 {
    margin: 0 0 0.75rem;
    color: var(--text);
    font-size: 0.75rem;
    font-weight: 600;
  }

  .file-panel ul {
    margin: 0;
    padding-left: 1rem;
    color: var(--text-muted);
    font-family: ui-sans-serif, system-ui, sans-serif;
    font-size: 0.875rem;
    line-height: 1.65;
  }

  .reference-column ul {
    padding: 0;
    list-style: none;
  }

  .reference-column h4:not(:first-child) { margin-top: 1.5rem; }
  .reference-column li + li { margin-top: 0.4rem; }
  .reference-column a { color: #b9f4d0; text-underline-offset: 0.18em; }
  .reference-column a:hover { color: var(--text); }

  @container (max-width: 48rem) {
    .file-panel { grid-template-columns: 1fr; }
